    refine sum_congr rfl fun j _ => ?_
    rw [ContinuousLinearMap.adjoint_inner_right, norm_inner_symm]
  have h2 : ∀ j, ‖A (b j)‖ ^ 2 = ∑ i, ‖⟪b i, A (b j)⟫_ℂ‖ ^ 2 := fun j => (b.sum_sq_norm_inner_right _).symm
  simp_rw [h1, h2]
